<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- TREE -->
        <record id="estate_property_tree_view" model="ir.ui.view">
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="type_id"/>
                    <field name="postcode"/>
                    <field name="date_availability"/>
                    <field name="expected_price"/>
                    <field name="best_offer"/>
                    <field name="selling_price"/>
                </tree>
            </field>
        </record>

        <!-- FORM -->
        <record id="estate_property_form_view" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_sold" type="object" string="Sold" class="btn-primary"/>
                        <button name="action_cancel" type="object" string="Cancel" class="btn-danger"/>
                        <button name="action_send_email" type="object" string="Send Email" class="btn-secondary"/>
                        <button name="%(action_report_property)d"
                                string="Print Report"
                                type="action"
                                class="btn-secondary"/>
                        <field name="state" widget="statusbar"/>
                    </header>

                    <sheet>

                        <!-- SMART BUTTON -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_property_view_offers"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-handshake-o">
                                <field name="offer_count" widget="statinfo" string="Offers"/>
                            </button>
                        </div>

                        <group>
                            <field name="name"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <group>
                                <field name="state"/>
                                <field name="type_id"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="best_offer"/>
                                <field name="selling_price"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area"/>
                                    <field name="garden_orientation"/>
                                    <field name="total_area"/>
                                </group>
                            </page>

                            <page string="Offers">
                                <field name="offer_ids">
                                    <tree editable="bottom">
                                        <field name="price"/>
                                        <field name="partner_id"/>
                                        <field name="creation_date"/>
                                        <field name="validity"/>
                                        <field name="deadline"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Other Info">
                                <group>
                                    <field name="sales_id"/>
                                    <field name="buyer_id"/>
                                    <field name="phone"/>
                                </group>
                            </page>
                        </notebook>

                    </sheet>

                    <div class="oe_chatter oe_chatter_position_right">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- KANBAN -->
        <record id="estate_property_kanban_view" model="ir.ui.view">
            <field name="name">estate.property.kanban</field>
            <field name="model">estate.property</field>
            <field name="priority" eval="10"/>
            <field name="arch" type="xml">
                <kanban default_group_by="state">
                    <field name="name"/>
                    <field name="expected_price"/>
                    <field name="selling_price"/>
                    <field name="best_offer"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click oe_kanban_card">
                                <strong><field name="name"/></strong>
                                <div>💰 <field name="expected_price"/></div>
                                <div>🏆 <field name="best_offer"/></div>
                                <div>✅ <field name="selling_price"/></div>
                                <div><field name="state"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- GRAPH -->
        <record id="estate_property_graph_view" model="ir.ui.view">
            <field name="name">estate.property.graph</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <graph type="bar">
                    <field name="type_id"/>
                    <field name="expected_price" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- PIVOT -->
        <record id="estate_property_pivot_view" model="ir.ui.view">
            <field name="name">estate.property.pivot</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="type_id" type="row"/>
                    <field name="state" type="col"/>
                    <field name="expected_price" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- CALENDAR -->
        <record id="estate_property_calendar_view" model="ir.ui.view">
            <field name="name">estate.property.calendar</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <calendar date_start="date_availability">
                    <field name="name"/>
                </calendar>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="estate_property_search_view" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="type_id"/>
                    <field name="sales_id"/>
                    <field name="state"/>
                    <filter name="filter_new" string="New" domain="[('state','=','new')]"/>
                    <filter name="filter_received" string="Offer Received" domain="[('state','=','received')]"/>
                    <filter name="filter_accepted" string="Accepted" domain="[('state','=','accepted')]"/>
                    <filter name="filter_sold" string="Sold" domain="[('state','=','sold')]"/>
                    <filter name="filter_cancel" string="Canceled" domain="[('state','=','cancel')]"/>
                    <separator/>
                    <filter name="filter_garden" string="With Garden" domain="[('garden','=',True)]"/>
                    <filter name="filter_high_price" string="High Price (>100000)" domain="[('expected_price','>',100000)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_type" string="Property Type" context="{'group_by':'type_id'}"/>
                        <filter name="group_by_sales" string="Salesman" context="{'group_by':'sales_id'}"/>
                        <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- FINAL ACTION -->
        <record id="action_property" model="ir.actions.act_window">
            <field name="name">Property</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">kanban,tree,form,graph,pivot,calendar</field>
            <field name="view_ids" eval="[
                (5,0,0),
                (0,0,{'view_mode':'kanban','view_id':ref('estate_property_kanban_view')}),
                (0,0,{'view_mode':'tree','view_id':ref('estate_property_tree_view')}),
                (0,0,{'view_mode':'form','view_id':ref('estate_property_form_view')})
            ]"/>
        </record>

    </data>
</odoo>
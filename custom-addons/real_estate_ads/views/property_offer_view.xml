<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- TREE -->
        <record id="estate_property_offer_tree_view" model="ir.ui.view">
            <field name="name">estate.property.offer.tree</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="price"/>
                    <field name="status"/>
                    <field name="partner_id"/>
                    <field name="property_id"/>
                    <field name="deadline"/>
                </tree>
            </field>
        </record>

        <!-- FORM -->
        <record id="estate_property_offer_form_view" model="ir.ui.view">
            <field name="name">estate.property.offer.form</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="status"/>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                            <field name="validity"/>
                            <field name="deadline"/>
                            <field name="creation_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- KANBAN -->
        <record id="estate_property_offer_kanban_view" model="ir.ui.view">
            <field name="name">estate.property.offer.kanban</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="price"/>
                    <field name="status"/>
                    <field name="partner_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click oe_kanban_card">
                                <strong><field name="name"/></strong>
                                <div><field name="partner_id"/></div>
                                <div>💰 <field name="price"/></div>
                                <div><field name="status"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- GRAPH -->
        <record id="estate_property_offer_graph_view" model="ir.ui.view">
            <field name="name">estate.property.offer.graph</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <graph type="bar">
                    <field name="partner_id"/>
                    <field name="price" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- PIVOT -->
        <record id="estate_property_offer_pivot_view" model="ir.ui.view">
            <field name="name">estate.property.offer.pivot</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="partner_id" type="row"/>
                    <field name="status" type="col"/>
                    <field name="price" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- CALENDAR -->
        <record id="estate_property_offer_calendar_view" model="ir.ui.view">
            <field name="name">estate.property.offer.calendar</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <calendar date_start="deadline">
                    <field name="name"/>
                    <field name="partner_id"/>
                </calendar>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="estate_property_offer_search_view" model="ir.ui.view">
            <field name="name">estate.property.offer.search</field>
            <field name="model">estate.property.offer</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="price"/>
                    <field name="property_id"/>
                    <filter name="accepted" string="Accepted" domain="[('status','=','accepted')]"/>
                    <filter name="refused" string="Refused" domain="[('status','=','refused')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                        <filter name="group_by_property" string="Property" context="{'group_by':'property_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_property_offer" model="ir.actions.act_window">
            <field name="name">Property Offers</field>
            <field name="res_model">estate.property.offer</field>
            <field name="view_mode">kanban,tree,form,graph,pivot,calendar</field>
            <field name="view_ids" eval="[
                (5,0,0),
                (0,0,{'view_mode':'kanban','view_id':ref('estate_property_offer_kanban_view')}),
                (0,0,{'view_mode':'tree','view_id':ref('estate_property_offer_tree_view')}),
                (0,0,{'view_mode':'form','view_id':ref('estate_property_offer_form_view')})
            ]"/>
        </record>

    </data>
</odoo>
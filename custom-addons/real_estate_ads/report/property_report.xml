<!-- <?xml version="1.0" encoding="utf-8"?>
<odoo>
   <data>
    <!-- ================= REPORT ACTION ================= -->
    <record id="action_report_property" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate_ads.property_report_template</field>
        <field name="report_file">real_estate_ads.property_report_template</field>
        <field name="print_report_name">'Property - %s' % (object.name)</field>
    </record>

    <!-- ================= REPORT TEMPLATE ================= -->
    <template id="property_report_template">
        <t t-call="web.external_layout">
        <main>

            <t t-foreach="docs" t-as="o">

                <!-- HEADER -->
               <div class="row mb-3">
    <div class="col-6">
        <img t-if="res_company.logo"
             t-att-src="image_data_uri(res_company.logo)"
             style="max-height:80px;"/>
    </div>

    <div class="col-6 text-end">
        <h2 style="color:#2c3e50;">Property Report</h2>
        <p>
            <strong>Date:</strong>
            <span t-field="o.create_date"/>
        </p>
    </div>
</div>

                <hr/>

                <!-- PROPERTY INFO -->
                <h3 style="color:#34495e;">Property Details</h3>

                <table class="table table-bordered mt-3">
                    <tr>
                        <th>Name</th>
                        <td><span t-esc="o.name"/></td>
                    </tr>

                    <tr>
                        <th>Expected Price</th>
                        <td>
                            <span t-field="o.expected_price"/>
                        </td>
                    </tr>

                    <tr>
                        <th>Selling Price</th>
                        <td>
                            <span t-field="o.selling_price"/>
                        </td>
                    </tr>

                    <tr>
                        <th>Status</th>
                        <td>
                            <span t-if="o.state == 'new'" style="color:blue;">New</span>
                            <span t-if="o.state == 'offer_received'" style="color:orange;">Offer Received</span>
                            <span t-if="o.state == 'accepted'" style="color:green;">Accepted</span>
                            <span t-if="o.state == 'sold'" style="color:red;">Sold</span>
                        </td>
                    </tr>

                </table>

                <!-- DESCRIPTION -->
                <h3 class="mt-4" style="color:#34495e;">Description</h3>
                <p t-esc="o.description or 'No description available'"/>

                <!-- FOOTER -->
                <div class="mt-5 text-center text-muted">
                    <p>Generated by Odoo ERP System</p>
                </div>

                <div class="page-break"/>

            </t>
            </main>
        </t>
    </template>

    </data>

</odoo> -->